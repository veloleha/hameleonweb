# ========================================
# HAMELEONWEB Backend Configuration
# ========================================

# Copy this file to .env and fill in your values:
# cp .env.example .env

# ----------------------------------------
# Database (SQLite)
# ----------------------------------------
DB_PATH=./data/hameleonweb.db

# ----------------------------------------
# Telegram Bot
# ----------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_ID=425601155

# ----------------------------------------
# JWT Secret (generate strong random string)
# ----------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_me_32_chars
JWT_EXPIRE_HOURS=24

# ----------------------------------------
# NOWPayments (Crypto payments)
# Get API key from: https://nowpayments.io
# ----------------------------------------
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_for_webhooks
MIN_PAYMENT_USD=11

# ----------------------------------------
# License Config
# ----------------------------------------
TRIAL_DAYS=7

# ----------------------------------------
# Domain (for SSL)
# ----------------------------------------
DOMAIN=yourdomain.com
